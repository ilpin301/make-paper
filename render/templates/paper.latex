\documentclass[a4paper,11pt$if(classoption)$,$classoption$$endif$]{article}

\usepackage{fontspec}
% Reference the TeX Gyre Termes (Times-like) OTFs by filename so the Tectonic
% bundle supplies them — avoids depending on an OS-installed font by name.
\setmainfont{texgyretermes}[
  Extension = .otf,
  UprightFont = *-regular,
  BoldFont = *-bold,
  ItalicFont = *-italic,
  BoldItalicFont = *-bolditalic,
]
\usepackage{polyglossia}
\setdefaultlanguage{german}

\usepackage{amsmath}
\usepackage{graphicx}
\usepackage{booktabs}
\usepackage{longtable}
\usepackage{array}
\usepackage{calc} % pandoc emits (\linewidth - X\tabcolsep) * \real{...} column widths
\usepackage[table]{xcolor} % colortbl for \rowcolor; load before hyperref
\definecolor{tableheadbg}{RGB}{217,226,243}
\usepackage{ragged2e}
\setlength{\columnsep}{0.8cm}
\usepackage[a4paper,margin=2.3cm]{geometry}
\usepackage[hidelinks]{hyperref}

% No hyphenation anywhere, tables included; the abstract stays justified
% and gets emergency stretch instead of hyphens.
\hyphenpenalty=10000
\exhyphenpenalty=10000
\emergencystretch=3em

% --- Pandoc compatibility shims ---
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
% Scale oversized images (e.g. wide Mermaid diagrams) down to the text width.
\providecommand{\pandocbounded}[1]{%
  \begingroup\sbox0{#1}%
  \ifdim\wd0>\linewidth \resizebox{\linewidth}{!}{\usebox0}\else \usebox0\fi
  \endgroup}
$if(highlighting-macros)$
$highlighting-macros$
$endif$

\usepackage{caption}
\captionsetup{font=footnotesize,labelfont=bf,labelsep=colon}
\captionsetup[table]{skip=4pt}

% Paragraph indent ~3 spaces; first paragraphs after headings stay flush
% (LaTeX default). \RaggedRight replaces \parindent with its own register,
% which defaults to 0pt — keep BOTH in sync or the indent silently vanishes.
\setlength{\parindent}{1em}
\setlength{\RaggedRightParindent}{1em}

% Columns end where their content ends. The twocolumn default \flushbottom
% force-stretches vertical glue when a column break leaves a column short,
% dumping large gaps after section headings.
\raggedbottom

% Dot after first-level section numbers only ("1. Einleitung", "1.1 ...").
% \thesubsection is restated without \thesection so it doesn't become "1..1".
\renewcommand{\thesection}{\arabic{section}.}
\renewcommand{\thesubsection}{\arabic{section}.\arabic{subsection}}
% Single regular space between section number and heading text
% (the article class default \@seccntformat inserts a \quad).
\makeatletter
\renewcommand{\@seccntformat}[1]{\csname the#1\endcsname\space}
\makeatother

% Tables carry vertical column separators; collapse booktabs' rule
% separation so those lines meet the horizontal rules without gaps.
\setlength{\aboverulesep}{0pt}
\setlength{\belowrulesep}{0pt}
\renewcommand{\arraystretch}{1.15}

% Full-width title block + italic abstract under an unnumbered
% section-style "Abstract" heading.
\newcommand{\paperhead}{%
  \begin{center}
    {\LARGE\bfseries $if(title)$$title$$else$\enspace$endif$\par}
    \vskip 0.9em
    $if(author)${\normalsize $author$\par}$endif$
    $if(dateline)${\normalsize $dateline$\par}$endif$
  \end{center}
  $if(abstract)$
  \section*{Abstract}
  {\itshape\leftskip=2em\rightskip=2em\noindent $abstract$\par}
  \vskip 1.2em
  $endif$
}

\begin{document}
$if(classoption)$
\twocolumn[{\paperhead}]
$else$
\paperhead
$endif$
% Body flush left; \RaggedRight (vs \raggedright) keeps \parindent.
% Title/abstract above set their own alignment, table cells stay centered.
\RaggedRight

$body$

\end{document}
